include README.md
include LICENSE
include pyproject.toml
include GETTING_STARTED.md
include PIPELINE_IMPLEMENTATION.md

recursive-include src *.py
recursive-include configs *.yaml

exclude train.py
exclude verify_setup.py
exclude test_pipeline_quick.py

recursive-exclude tests *
recursive-exclude examples *
recursive-exclude notebook *
recursive-exclude data.nosync *
recursive-exclude checkpoints.nosync *
recursive-exclude lightning_logs.nosync *
recursive-exclude outputs *
recursive-exclude wandb_logs *

global-exclude __pycache__
global-exclude *.py[co]
global-exclude .DS_Store
